---
layout: layouts/base.njk
title: "Reseñas"
permalink: "reviews.html"
---
<section>
	<h2>Reseñas</h2>

	<div class="review-grid">
		{% for review in collections.reviews %}
		<article class="review-card">
			<a href="{{ review.url }}">
				<img class="review-card-poster" src="{{ review.data.poster }}" alt="{{ review.data.title }}" />
			</a>

    <div class="review-card-info">
	    <div class="review-card-line">
		    <a class="review-card-title" href="{{ review.url }}">{{ review.data.title }}</a>
		    <span class="review-card-sep">|</span>
		    <span class="rating">{{ review.data.rating }}</span>
	    </div>

	    <div class="review-card-tags">
		    {% for tag in review.data.tags %}
		    <span class="tag" data-tag="{{ tag }}">{{ tagLabels[tag] | default(tag) }}</span>
		    {% endfor %}
	    </div>
    </div>
		</article>
		{% else %}
		<p class="nada">no hay nada todavia :/</p>
		{% endfor %}
	</div>
</section>
