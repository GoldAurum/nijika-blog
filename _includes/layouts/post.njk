---
layout: layouts/base.njk
---
<section>
	<h1>{{ title }}</h1>
    <div class="post-meta">
	    {% if date %}<span class="post-date">{{ date | postDate }}</span>{% endif %}
	    {% if likes %}<ws-widget type="like" iid="{{ likes }}"></ws-widget>{% endif %}
    </div>
	{% if description %}<p style="opacity: 60%">{{ description }}</p>{% endif %}
</section>

<hr />

<section>
	{{ content | safe }}
</section>

<p style="opacity: 60%; text-align: right">by {{ author | default("Gold") }}</p>
