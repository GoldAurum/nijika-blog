<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>
			{% if title %}
				{{ title }} - nijika.osaka
			{% else %}
				nijika.osaka
			{% endif %}
		</title>
		<link rel="icon" href="/assets/Logo_Gold.png" />
		<link rel="stylesheet" href="/assets/styles.css" />
	</head>

	<body>
		<header>
		<script src="https://u.widget.st/ar.js"></script>
			<div class="nav">
				<div class="logo">
					<a href="/">
						<img src="/assets/Logo_Gold.png" />
					</a>
				</div>
				<div class="nav-actions">
					<a href="/reviews" class="reviews-button">Reviews</a>

					<label class="theme-switch">
						<input type="checkbox" id="theme-toggle" />
						<span class="slider"></span>
					</label>
				</div>
			</div>
		</header>

		{{ content | safe }}

		<div class="nijika-gif" id="nijika-gif">
			<img src="/assets/nijika.gif" alt="Nijika">
		</div>

		<audio id="nijika-sound" src="/assets/nijika.mp3" preload="auto"></audio>

		<script src="/assets/scripts/tags.js"></script>
		<script src="/assets/scripts/page-style-mode.js"></script>
		<script src="/assets/scripts/nijika-sound.js"></script>
		<script src="/assets/scripts/nijika-secret.js"></script>
	</body>
</html>
